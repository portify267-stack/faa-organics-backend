# Server Configuration
PORT=5000
NODE_ENV=development

# API Configuration
API_PREFIX=/api/v1

# CORS Allowed Origins (Comma-separated for frontend customer store and React admin panel)
CLIENT_URL=http://localhost:3000,http://localhost:5173
ADMIN_URL=http://localhost:3001,http://localhost:5174

# Database Configuration (MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/faa_organic

# JWT Authentication Configuration
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=1d

# Admin Login Rate Limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_ATTEMPTS=5

# Initial Superadmin Setup (Used by npm run seed:admin)
INITIAL_ADMIN_NAME=Super Admin
INITIAL_ADMIN_EMAIL=admin@faaorganic.com
INITIAL_ADMIN_PASSWORD=your_secure_password_here
